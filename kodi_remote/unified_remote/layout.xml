<?xml version="1.0" encoding="utf-8"?>
<layout color="#1E2A38" onLaunch="launch" onVolumeUp="volume_up" onVolumeDown="volume_down">
	<row weight="wrap">
		<label id="status" text="Kodi: starting..." />
	</row>
	<row weight="1">
		<button icon="back" ontap="back" />
		<button icon="home" ontap="home" />
		<button icon="more" ontap="menu" />
	</row>
	<row weight="5">
		<dpad ontap="select" icon="select">
			<item ontap="up" onhold="up" />
			<item ontap="right" onhold="right" />
			<item ontap="down" onhold="down" />
			<item ontap="left" onhold="left" />
		</dpad>
	</row>
	<row weight="1">
		<button icon="rwd" ontap="rewind" />
		<button icon="playpause" ontap="play_pause" />
		<button icon="ff" ontap="fast_forward" />
		<button icon="stop" ontap="stop" />
	</row>
	<row weight="1">
		<button icon="vdown" ontap="volume_down" />
		<button icon="vmute" ontap="volume_mute" />
		<button icon="vup" ontap="volume_up" />
		<button text="Info" ontap="info" />
	</row>
	<row weight="1">
		<button icon="fullscreen" text="Fullscreen" ontap="fullscreen" />
		<button text="Close Kodi" ontap="quit" />
	</row>
</layout>
